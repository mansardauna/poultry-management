# ==============================================================================
# Poultry Management System (PMS) - Environment Configuration
# ==============================================================================

NEXT_PUBLIC_APP_NAME="Poultry Management System"

# ------------------------------------------------------------------------------
# 1. Cryptographic Session Secret (Required in production)
# ------------------------------------------------------------------------------
# 32+ character random secret used by jose to sign HS256 auth session JWTs.
# If omitted in development, a local persistent dev secret is automatically generated.
SESSION_SECRET="your-super-strong-jwt-secret-key-at-least-32-chars"

# ------------------------------------------------------------------------------
# 2. Database Configuration (Choose ONE of the following options)
# ------------------------------------------------------------------------------
# You can also configure your database visually via the onboarding wizard at /setup.

# OPTION A: Local / Self-Hosted MySQL (Recommended for local dev / XAMPP)
DATABASE_URL="mysql://root:@localhost:3306/poultry_db"

# OPTION B: Local / Self-Hosted PostgreSQL
# DATABASE_URL="postgresql://postgres:password@localhost:5432/poultry_db"

# OPTION C: Cloud Supabase (Optional - Only needed if using Supabase as database)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_FETCH_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 3. SuperAdmin Initial Bootstrap (Optional)
# ------------------------------------------------------------------------------
# Used to seed or bootstrap initial administrative credentials on first run.
PFMS_ADMIN_USERNAME="owner"
PFMS_ADMIN_PASSWORD="PoultryFarm@2026!"

# ------------------------------------------------------------------------------
# 4. Optional Payment Gateways (Stripe & Paystack)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
# PAYSTACK_PUBLIC_KEY="pk_test_..."
# PAYSTACK_SECRET_KEY="sk_test_..."

# ------------------------------------------------------------------------------
# 5. Optional AI Telemetry & Voice Logger (Gemini)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY="your-gemini-api-key"

# Dev/test only: accept PAY-SIM-/PAY-DIRECT-/DEMO- invoice refs. Ignored unless NODE_ENV is development or test.
ALLOW_SIMULATED_PAYMENTS=false
